{
  "name": "@yt-dlx/yt",
  "description": "YouTube Media Extractor & Downloader",
  "version": "0.3.0",
  "module": "entry.ts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "build": "bun build.ts && dts-bundle-generator --no-check -o dist/index.d.ts src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "latest",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jiti": "2.7.0",
    "typescript-eslint": "8.71.0",
    "typescript": "5",
    "dts-bundle-generator": "9.5.1"
  },
  "files": [
    "dist"
  ]
}
